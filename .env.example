# ==============================================================================
# AzkaMandiri - Jasa Aplikator Aluminium & Kaca
# Environment Configuration Template
# ==============================================================================

APP_NAME="AzkaMandiri"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# MySQL 8.0+ Database Configuration
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=azkamandiri
DB_USERNAME=root
DB_PASSWORD=root

# ------------------------------------------------------------------------------
# Session, Cache, & Queue (Database Driver Default)
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ------------------------------------------------------------------------------
# Mail Configuration (Optional for notifications / password resets)
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="halo@azkamandiri.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Vite Frontend Assets
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
